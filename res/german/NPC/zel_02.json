[
    {
        "ID": "19, 147",
        "text": [
            "Hast du mit Renado, dem Priester,",
            "gesprochen?"
        ]
    },
    {
        "ID": "19, 148",
        "text": [
            "Natürlich mache ich mir auch Sor-",
            "gen um Ilia, aber noch dringlicher",
            "erscheint mir die Sache mit den",
            "Zoras am Hylia-See."
        ]
    },
    {
        "ID": "20, 108",
        "text": [
            "Wenn nur Ilia noch ihr Gedächtnis",
            "wiederfinden würde, dann wäre",
            "alles wieder gut!"
        ]
    },
    {
        "ID": "20, 109",
        "text": [
            "Ich bin so froh, dass Ralis und Ilia",
            "wieder zu Kräften gekommen sind."
        ]
    },
    {
        "ID": "20, 185",
        "text": [
            "Aber ich frage mich, wo Malo",
            "sich herumtreibt... Dass er nicht",
            "einmal einen Krankenbesuch bei",
            "Colin macht!"
        ]
    },
    {
        "ID": "20, 195",
        "text": [
            "Da vor dem Brunnen steht Malo...",
            "Geh am besten zu ihm und zeig's",
            "mir von dort aus, ja?"
        ]
    },
    {
        "ID": "20, 215",
        "text": [
            "Malo ist in den Laden dort",
            "gegangen. Und irgendwas",
            "scheint er da zu machen..."
        ]
    },
    {
        "ID": "21, 55",
        "text": [
            "Talo wird so enttäuscht sein...!",
            "Der Arme..."
        ]
    },
    {
        "ID": "21, 225",
        "text": [
            "{1a05000000},",
            "{1a07000007000a}du musst Ilia retten...",
            "Je eher, umso besser!"
        ]
    },
    {
        "ID": "21, 230",
        "text": [
            "Der Priester hat gesagt, dass",
            "Ilia ihr Gedächtnis vielleicht",
            "wiedererlangen wird."
        ]
    },
    {
        "ID": "21, 234",
        "text": [
            "Ilia betet jeden Tag im Heiligtum."
        ]
    },
    {
        "ID": "21, 241",
        "text": [
            "Ilia geht jeden Tag ins Heiligtum,",
            "um zu beten."
        ]
    },
    {
        "ID": "21, 243",
        "text": [
            "Ich bin so froh, dass Ilia ihr",
            "Gedächtnis zurück hat."
        ]
    },
    {
        "ID": "22, 61",
        "text": [
            "Endlich kann man wieder in die",
            "Mine... da habe ich gleich für",
            "Barnes ein paar Rohstoffe zur",
            "Bombenherstellung mitgebracht."
        ]
    },
    {
        "ID": "22, 82",
        "text": [
            "Sein Name ist {1a06ff000001}Bo{1a06ff000000}... Genau,",
            "der {1a06ff000001}Bürgermeister{1a06ff000000} deines Heimat-",
            "dorfes {1a06ff000001}Ordon{1a06ff000000}. Den meine ich!"
        ]
    },
    {
        "ID": "22, 86",
        "text": [
            "Und wenn du tatsächlich zum",
            "Feuerberg gehen willst... hole dir",
            "auf jeden Fall Rat bei {1a06ff000001}Bo{1a06ff000000}!"
        ]
    },
    {
        "ID": "22, 97",
        "text": [
            "Auch Talo geht es endlich wieder",
            "besser... Er war ja wegen der Sache",
            "mit Colin sehr niedergeschlagen."
        ]
    },
    {
        "ID": "22, 101",
        "text": [
            "Aber zunächst werde ich erkunden,",
            "ob es nicht irgendein gutes Mittel",
            "gibt, Ilia alsbald ihre",
            "Erinnerungen wiederzugeben."
        ]
    },
    {
        "ID": "22, 103",
        "text": [
            "Ich werde bestimmt eine",
            "Möglichkeit finden, Ilia ihre",
            "Erinnerungen zurückzugeben."
        ]
    },
    {
        "ID": "22, 106",
        "text": [
            "Ich habe gute Nachrichten!",
            "Wenn alles klappt, können wir Ilia",
            "ihre Erinnerungen zurückgeben."
        ]
    },
    {
        "ID": "22, 115",
        "text": [
            "{1a05000000}, mit deiner Hilfe",
            "wird Ilia bestimmt ihr Gedächtnis",
            "zurückbekommen!"
        ]
    },
    {
        "ID": "22, 117",
        "text": [
            "Wenn wir Ilias Handlungen zurück-",
            "verfolgen, finden wir ganz sicher",
            "irgendein Mittel, ihr zu helfen."
        ]
    },
    {
        "ID": "22, 119",
        "text": [
            "Wenn wir Ilia das zeigen, erinnert",
            "sie sich vielleicht an irgendetwas."
        ]
    },
    {
        "ID": "22, 123",
        "text": [
            "Ich bin so froh, dass Ilia wieder",
            "gesund geworden ist."
        ]
    },
    {
        "ID": "22, 130",
        "text": [
            "Ich bin so froh, dass Ilia wieder",
            "gesund geworden ist."
        ]
    },
    {
        "ID": "22, 140",
        "text": [
            "Ich dachte, Ilia würde etwas Ab-",
            "wechslung gut tun, deshalb",
            "hab ich sie gebeten, ins Heiligtum",
            "zu kommen."
        ]
    },
    {
        "ID": "22, 145",
        "text": [
            "Kennst du eigentlich {1a06ff000002}Shad{1a06ff000000}, den",
            "Bekannten von Telma?"
        ]
    },
    {
        "ID": "22, 147",
        "text": [
            "Dabei hat {1a06ff000002}Ilia{1a06ff000000} sich daran erinnert,",
            "dass sie von ihrem Helfer etwas",
            "über irgendeinen {1a06ff000001}Stab aus den",
            "Wolken{1a06ff000000} gehört hat."
        ]
    },
    {
        "ID": "22, 148",
        "text": [
            "{1a06ff000001}Shad {1a06ff000000}ist schon die ganze Zeit in",
            "den {1a06ff000001}Katakomben {1a06ff000000}unter dem Heilig-",
            "tum und untersucht die Stein-",
            "statue."
        ]
    },
    {
        "ID": "22, 150",
        "text": [
            "Und auch von den {1a06ff000001}Goronen{1a06ff000000}!",
            "{1a070000070014}{1a06ff000001}Bo{1a06ff000000} genießt ihr Vertrauen...",
            "Er kann dir sicherlich helfen!"
        ]
    },
    {
        "ID": "23, 144",
        "text": [
            "Der hat doch gesagt, wir brauchen",
            "den {1a06ff000001}Schattenkristall{1a06ff000000}, um die Welt",
            "vor Zant zu retten, dem Herrscher",
            "der Schatten!"
        ]
    },
    {
        "ID": "24, 75",
        "text": [
            "Unser Oberhaupt Darbus ist schon",
            "vorausgegangen und wartet. Wenn",
            "du ihn nicht findest, sieh einfach",
            "auf der {1a06ff000001}Karte{1a06ff000000} nach!"
        ]
    },
    {
        "ID": "24, 81",
        "text": [
            "Renado ist so freundlich, mich",
            "für eine Weile hier im Dorf",
            "aufzunehmen."
        ]
    },
    {
        "ID": "24, 87",
        "text": [
            "{1a05000000}, kennst du",
            "eigentlich Shad?"
        ]
    },
    {
        "ID": "24, 110",
        "text": [
            "Dieser Shad in den {1a06ff000001}Katakomben{1a06ff000000}...",
            "Ist das ein Bekannter von dir?"
        ]
    },
    {
        "ID": "24, 112",
        "text": [
            "{1a05000000}! Shad wartet schon",
            "in den {1a06ff000001}Katakomben{1a06ff000000}..."
        ]
    },
    {
        "ID": "25, 110",
        "text": [
            "Ääähm... Man nennt mich {1a06ff000002}Shad{1a06ff000000}.",
            "Ich untersuche die Legende von",
            "den {1a06ff000001}Kumulanern{1a06ff000000}, die man sich in",
            "Hyrule erzählt..."
        ]
    },
    {
        "ID": "25, 137",
        "text": [
            "Wir haben nichts als {1a06ff000001}Ilias Er-",
            "innerung{1a06ff000000} über diese Stadt in",
            "den {1a06ff000001}Wolken{1a06ff000000}."
        ]
    },
    {
        "ID": "25, 140",
        "text": [
            "Ach... {1a07000007000a}wenn Ilia sich doch nur",
            "erinnern würde..."
        ]
    },
    {
        "ID": "25, 163",
        "text": [
            "Diese Ilia ist doch eine Bekannte",
            "von dir, oder?"
        ]
    },
    {
        "ID": "25, 206",
        "text": [
            "Beim {1a06ff000001}Malomarkt{1a06ff000000} wird gerade eine",
            "{1a06ff000001}Sammlung{1a06ff000000} für die {1a06ff000001}Reparatur{1a06ff000000} der",
            "Brücke durchgeführt..."
        ]
    },
    {
        "ID": "27, 97",
        "text": [
            "Du sollst doch zu diesem Bo",
            "gehen, oder? Dann sollten wir",
            "uns etwas beeilen!"
        ]
    },
    {
        "ID": "31, 67",
        "text": [
            "{1a07ff00010096}{1a06ff000001}Achtung!{1a07ff00010064}{1a06ff000000}",
            "Betreten verboten!",
            "",
            "          Barnes"
        ]
    }
]