[
    {
        "ID": "0, 138",
        "text": [
            "{1a09030000000007ee}{1a05000001}Du hast die {1a06ff000001}Ooccoo{1a06ff000000} getroffen!{1a05000002}",
            "Sie warpt dich aus jedem Dun-",
            "geon... oder dorthin zurück,",
            "wo du zuletzt warst.",
            "Lege sie auf {1a05000010} oder {1a0500000f}, um",
            "sie verwenden zu können."
        ]
    },
    {
        "ID": "0, 141",
        "text": [
            "{1a05000001}Du erhältst das {1a06ff000001}Ordon-",
            "Schwert{1a06ff000000}!{1a05000002} {1a07000007000a}Rusl hat es als",
            "Geschenk für den Hof von",
            "Hyrule angefertigt."
        ]
    },
    {
        "ID": "0, 152",
        "text": [
            "{1a09030000000007fc}{1a05000001}Du hast die {1a06ff000001}Ooccoo {1a06ff000000}wieder-",
            "getroffen!{1a05000002} {1a07000007000a}Lege sie auf {1a05000010}",
            "oder {1a0500000f}, um das Dungeon",
            "zu verlassen."
        ]
    },
    {
        "ID": "0, 229",
        "text": [
            "{1a0903000000000849}{1a05000001}Du erhältst {1a06ff000001}Renados Brief{1a06ff000000}!{1a05000002}",
            "{1a07000007000a}Er beschreibt, wie du Ilias",
            "Erinnerung zurückbringst.",
            "",
            "Lege ihn auf {1a05000010} oder {1a0500000f}, um",
            "ihn dem Empfänger zu zeigen."
        ]
    },
    {
        "ID": "0, 231",
        "text": [
            "{1a090300000000084b}{1a05000001}Du findest die {1a06ff000001}Schnitzerei{1a06ff000000}",
            "wieder!{1a05000002} {1a07000007000a}Eine seltsame Statue,",
            "die ursprünglich Ilia gehörte.",
            "",
            "Sie könnte der Schlüssel zu",
            "Ilias Gedächtnis sein. Lege",
            "sie auf {1a05000010} oder {1a0500000f}, um sie",
            "zu verwenden!"
        ]
    },
    {
        "ID": "0, 232",
        "text": [
            "{1a090300000000084c}{1a05000001}Du erhältst {1a06ff000001}Ilias Halskette{1a06ff000000}!{1a05000002}",
            "Sie gehörte früher der Alten,",
            "die Ilia gerettet hat... ein",
            "Schlüssel zu Ilias Erinnerung!",
            "Lege sie auf {1a05000010} oder {1a0500000f}, um sie",
            "zu verwenden."
        ]
    },
    {
        "ID": "0, 233",
        "text": [
            "{1a090300000000084d}{1a05000001}Du erhältst die {1a06ff000001}tönerne Flöte{1a06ff000000}!{1a05000002}",
            "{1a07000007000a}Ilia hatte sie für dich und",
            "{1a05000022} angefertigt...",
            "",
            "Lege sie auf {1a05000010} oder {1a0500000f}, um",
            "{1a05000022} zu rufen, wenn",
            "du im Freien unterwegs bist."
        ]
    },
    {
        "ID": "0, 245",
        "text": [
            "{1a0903000000000859}{1a05000001}Du erhältst {1a06ff000001}Aurus Notiz{1a06ff000000}!{1a05000002}",
            "{1a07000007000a}Sie ist für {1a06ff000001}Fyer{1a06ff000000} bestimmt, den",
            "du am Hylia-See findest.",
            "",
            "Lege sie auf {1a05000010} oder {1a0500000f}, um sie",
            "ihm zu zeigen!"
        ]
    },
    {
        "ID": "1, 81",
        "text": [
            "Du freundest dich mit der",
            "{1a05000001}{1a06ff000001}Ooccoo {1a06ff000000}an!{1a05000002} {1a07000007000a}Sie kann dich in",
            "den Laden von Kumula warpen.",
            "",
            "Lege sie auf {1a05000010} oder {1a0500000f} und",
            "verwende sie, um schnell und",
            "sicher in die Stadt in den",
            "Wolken zu reisen."
        ]
    },
    {
        "ID": "1, 138",
        "text": [
            "Ooccoo"
        ]
    },
    {
        "ID": "1, 140",
        "text": [
            "Ooccoos Liebling"
        ]
    },
    {
        "ID": "1, 146",
        "text": [
            "Ooccoos Notiz"
        ]
    },
    {
        "ID": "1, 152",
        "text": [
            "Ooccoo"
        ]
    },
    {
        "ID": "1, 229",
        "text": [
            "Renados Brief"
        ]
    },
    {
        "ID": "1, 232",
        "text": [
            "Ilias Halskette"
        ]
    },
    {
        "ID": "1, 245",
        "text": [
            "Aurus Notiz"
        ]
    },
    {
        "ID": "2, 21",
        "text": [
            "Geruch von {1a06ff000001}Ilia"
        ]
    },
    {
        "ID": "2, 81",
        "text": [
            "Ooccoo"
        ]
    },
    {
        "ID": "2, 109",
        "text": [
            "{1a0903000000000c2d}Eine geliehene Bombentasche von Iza.",
            "Lege die Bomben auf {1a05000010} oder {1a0500000f} und",
            "verwende sie mithilfe von {1a0500000a}.",
            "Kombiniere sie auf dem Item-Bildschirm",
            "mithilfe von {1a0500000e} mit dem {1a06ff000001}Heroen-Bogen{1a06ff000000},",
            "um {1a06ff000001}Bombenpfeile{1a06ff000000} herzustellen."
        ]
    },
    {
        "ID": "2, 110",
        "text": [
            "Geliehene Bombentasche von Iza",
            "",
            "Eine leere Bombentasche... aber wenn",
            "du Iza bittest, füllt sie die Tasche",
            "wieder auf."
        ]
    },
    {
        "ID": "2, 138",
        "text": [
            "{1a0903000000000c4a}Eine wundervolle Reisebekannschaft.",
            "Rufe die Ooccoo mit {1a05000010} oder {1a0500000f}, wenn du",
            "das Dungeon verlassen willst. Sie führt",
            "dich dann hinaus."
        ]
    },
    {
        "ID": "2, 140",
        "text": [
            "{1a0903000000000c4c}Sprich ihn mit {1a05000010} oder {1a0500000f} an, um zurück",
            "ins Dungeon und zur Ooccoo gebracht zu",
            "werden. Gehst du ins Dungeon, ohne",
            "ihn zu verwenden, erwartet die Ooccoo",
            "dich am Eingang."
        ]
    },
    {
        "ID": "2, 146",
        "text": [
            "Hier steht:",
            "{1a06ff000001}Ich bleibe noch ein wenig im Dungeon.",
            "Wir treffen uns wieder, wenn du zurück-",
            "kommst.",
            "",
            "                                 Ooccoo"
        ]
    },
    {
        "ID": "2, 152",
        "text": [
            "{1a0903000000000c58}Wenn du das Dungeon verlassen",
            "willst, rufe mit {1a05000010} oder {1a0500000f} die Ooccoo.",
            "Sie warpt dich hinaus."
        ]
    },
    {
        "ID": "2, 154",
        "text": [
            "Geldbörse von Agitha, der Königin",
            "des Insektenreichs. Bewahre in ihr",
            "bis zu 600 Rubine auf!"
        ]
    },
    {
        "ID": "2, 155",
        "text": [
            "Ein Geschenk von Agitha: Höchste",
            "Auszeichnung, die das Insektenreich",
            "bietet. Fasst bis zu 1000 Rubine."
        ]
    },
    {
        "ID": "2, 229",
        "text": [
            "{1a0903000000000ca5}Ein Brief von Renado an Telma. Er",
            "beschreibt, wie Ilia ihr Gedächtnis zurück-",
            "gewinnen kann. Willst du ihn weitergeben,",
            "lege ihn auf {1a05000010} oder {1a0500000f}."
        ]
    },
    {
        "ID": "2, 231",
        "text": [
            "{1a0903000000000ca7}Gehörte früher zu Ilias Besitztümern.",
            "Die Form ist sehr ungewöhnlich: Sie wird",
            "helfen, Ilias Gedächtnis zurückzubringen.",
            "Lege sie auf {1a05000010} oder {1a0500000f}, um sie weiterzu-",
            "geben."
        ]
    },
    {
        "ID": "2, 232",
        "text": [
            "{1a0903000000000ca8}Halskette der Alten, die Ilia gerettet hat.",
            "Soll helfen, Ilias Gedächtnis zurückzu-",
            "bringen.",
            "Lege sie auf {1a05000010} oder {1a0500000f}, um sie weiterzu-",
            "geben."
        ]
    },
    {
        "ID": "2, 233",
        "text": [
            "{1a0903000000000ca9}Ilia wollte sie dir schenken.",
            "Lege sie auf {1a05000010} oder {1a0500000f}, um {1a05000022}",
            "herbeizurufen."
        ]
    },
    {
        "ID": "2, 245",
        "text": [
            "{1a0903000000000cb5}Eine Notiz von Auru für Fyer.",
            "Lege sie auf {1a05000010} oder {1a0500000f}, um sie Fyer zu",
            "zeigen. Du findest ihn am Hylia-See."
        ]
    },
    {
        "ID": "2, 246",
        "text": [
            "{1a0903000000000cb6}Die Zeichnung zeigt einen Riesen, der",
            "einen {1a06ff000001}roten Fisch{1a06ff000000} trägt. Ashei hat die",
            "Szene beobachtet. Lege sie auf {1a05000010} oder {1a0500000f}",
            "und zeige sie verschiedenen Leuten."
        ]
    },
    {
        "ID": "3, 21",
        "text": [
            "Der Geruch der Tasche, die",
            "Ilia immer bei sich hatte.",
            "Sie lag in der Ebene von",
            "Ranelle."
        ]
    },
    {
        "ID": "3, 81",
        "text": [
            "{1a0903000000000d11}Die unglaubliche Ooccoo.",
            "Rufe sie mit {1a05000010} oder {1a0500000f}, und sie bringt",
            "dich zu ihrem Geschäft."
        ]
    },
    {
        "ID": "4, 134",
        "text": [
            "{1a07ff00010052}Usurpator{1a07ff00010064}",
            "ZANT{1a07000004005a}"
        ]
    },
    {
        "ID": "11, 194",
        "text": [
            "Aber es wird spät. Wir sollten",
            "langsam ins Dorf zurückkehren.",
            "",
            "",
            "Und wegen deiner Reise...",
            "Ich werde alles mit dem",
            "Bo besprechen."
        ]
    },
    {
        "ID": "11, 211",
        "text": [
            "Aber, aber, Ilia...",
            "Reg dich doch nicht gleich",
            "so auf!{1a07000004001e}"
        ]
    },
    {
        "ID": "11, 216",
        "text": [
            "A... aber Ilia!",
            "",
            "",
            "",
            "Ohne {1a05000022} kann",
            "{1a05000000} das Geschenk",
            "doch nie rechtzeitig abliefern!"
        ]
    },
    {
        "ID": "15, 197",
        "text": [
            "Eine Rute aus Holz!",
            "{1a07000007002d}Damit hat Talo immer gespielt..."
        ]
    },
    {
        "ID": "16, 241",
        "text": [
            "{1a05000001}Du hast die {1a06ff000001}Ooccoo{1a06ff000000} getroffen!{1a05000002}",
            "Mit ihrer Hilfe kannst du das",
            "Dungeon verlassen und zum",
            "{1a06ff000001}Ursprungsort{1a06ff000000} zurückkehren.",
            "Rufe mithilfe von {1a05030004} den Item-",
            "Bildschirm auf und lege sie",
            "auf {1a05030002} oder {1a05030008}. Du rufst sie",
            "dann mithilfe von {1a05030002} oder {1a05030008}."
        ]
    },
    {
        "ID": "16, 255",
        "text": [
            "{1a05000001}Du hast die {1a06ff000001}Ooccoo{1a06ff000000} wiederge-",
            "troffen!{1a05000002} {1a07000007000a}Mit ihrer Hilfe kommst",
            "du aus dem Dungeon heraus",
            "und wieder hinein!",
            "Rufe mithilfe von {1a05030004} den Item-",
            "Bildschirm auf und lege sie",
            "auf {1a05030002} oder {1a05030008}. Du rufst sie",
            "dann mithilfe von {1a05030002} oder {1a05030008}."
        ]
    },
    {
        "ID": "17, 76",
        "text": [
            "{1a05000001}Du erhältst {1a06ff000001}Renados Brief{1a06ff000000}!{1a05000002}",
            "{1a07000007000a}Er beschreibt, wie du Ilias",
            "Erinnerung zurückbringst.",
            "",
            "Öffne mit {1a05030004} den Item-Bild-",
            "schirm, lege ihn auf {1a05030002} oder {1a05030008}.",
            "Auf {1a05030008} kannst du ihn direkt zei-",
            "gen, ohne ihn auf {1a05030002} umzulegen."
        ]
    },
    {
        "ID": "17, 78",
        "text": [
            "{1a05000001}Du findest die {1a06ff000001}Schnitzerei{1a06ff000000}",
            "wieder!{1a05000002}",
            "",
            "",
            "{1a07000007000a}Eine seltsame Statue,",
            "die ursprünglich Ilia",
            "gehörte... Ein Schlüssel",
            "zu Ilias Erinnerung.",
            "Öffne mit {1a05030004} den Item-Bild-",
            "schirm, lege sie auf {1a05030002} oder {1a05030008}.",
            "Auf {1a05030008} kannst du sie direkt zei-",
            "gen, ohne sie auf {1a05030002} umzulegen."
        ]
    },
    {
        "ID": "17, 79",
        "text": [
            "{1a05000001}Du erhältst {1a06ff000001}Ilias Halskette{1a06ff000000}!{1a05000002}",
            "",
            "",
            "",
            "{1a07000007000a}Die Alte, die Ilia gerettet hat,",
            "trug sie als Talisman... ein",
            "wichtiger Schlüssel zu Ilias",
            "Erinnerung!",
            "Öffne mit {1a05030004} den Item-Bild-",
            "schirm, lege sie auf {1a05030002} oder {1a05030008}.",
            "Auf {1a05030008} kannst du sie direkt zei-",
            "gen, ohne sie auf {1a05030002} umzulegen."
        ]
    },
    {
        "ID": "17, 80",
        "text": [
            "{1a090300000000084d}{1a05000001}Du erhältst die {1a06ff000001}tönerne Flöte{1a06ff000000}!{1a05000002}",
            "{1a07000007000a}Ilia hatte sie für dich",
            "selbst gemacht...",
            "",
            "Damit kannst du {1a05000022}",
            "rufen, auch wenn kein Gras in",
            "deiner Nähe ist.",
            "",
            "Öffne mit {1a05030004} den Item-Bild-",
            "schirm, lege sie auf {1a05030002} oder {1a05030008}.",
            "Auf {1a05030008} kannst du sie direkt ver-",
            "wenden, ohne auf {1a05030002} umzulegen."
        ]
    },
    {
        "ID": "17, 92",
        "text": [
            "{1a05000001}Du erhältst {1a06ff000001}Aurus Notiz{1a06ff000000}!{1a05000002}",
            "{1a07000007000a}Sie ist für Fyer bestimmt, den",
            "du am Hylia-See findest.",
            "",
            "Öffne mit {1a05030004} den Item-Bild-",
            "schirm, lege sie auf {1a05030002} oder {1a05030008}.",
            "Auf {1a05030008} kannst du sie direkt zei-",
            "gen, ohne sie auf {1a05030002} umzulegen."
        ]
    },
    {
        "ID": "12, 180",
        "text": [
            "Beth? Alles klar?"
        ]
    },
    {
        "ID": "12, 208",
        "text": [
            "Entschuldige, ich habe mich gar",
            "nicht vorgestellt... Mein Name ist",
            "{1a06ff000002}Renado{1a06ff000000}. Ich bin der Priester",
            "dieses Ortes."
        ]
    },
    {
        "ID": "12, 210",
        "text": [
            "...ist meine Tochter {1a06ff000002}Luda{1a06ff000000}."
        ]
    },
    {
        "ID": "12, 242",
        "text": [
            "Beth... Entschuldige...",
            "Ich wollte dich nicht schubsen..."
        ]
    },
    {
        "ID": "12, 253",
        "text": [
            "Was ist mit Ilia?"
        ]
    },
    {
        "ID": "12, 254",
        "text": [
            "Du musst Ilia retten!"
        ]
    },
    {
        "ID": "13, 0",
        "text": [
            "Ich habe diesen Albtraum",
            "doch nur ausgehalten, weil",
            "ich immer Ilia und dich vor",
            "Augen hatte, {1a05000000}."
        ]
    },
    {
        "ID": "13, 4",
        "text": [
            "Mach dir um mich keine",
            "Sorgen mehr. Jetzt musst",
            "du Ilia retten!"
        ]
    },
    {
        "ID": "13, 119",
        "text": [
            "Weißt du, {1a05000000}...",
            "Ich mache mir auch Sorgen um Ilia."
        ]
    },
    {
        "ID": "13, 130",
        "text": [
            "Ich frage mich, ob ich noch ein",
            "wenig hier bleiben soll...? Ich",
            "mache mir schließlich auch Ge-",
            "danken wegen Ilia... Außerdem..."
        ]
    },
    {
        "ID": "13, 145",
        "text": [
            "Za-Zant...!{1a07000004001e}"
        ]
    },
    {
        "ID": "8, 103",
        "text": [
            "Ich frage mich, wie wir die Formel",
            "finden sollen, die dem Kopierstab",
            "seine Kraft zurückgibt... Wie konnte",
            "die Ooccoo sie nur vergessen?!?"
        ]
    },
    {
        "ID": "8, 107",
        "text": [
            "Zant ist im Schattenreich!"
        ]
    },
    {
        "ID": "8, 109",
        "text": [
            "{1a05000000}!",
            "Hilf mir, Zant zu besiegen!"
        ]
    },
    {
        "ID": "13, 209",
        "text": [
            "Außerdem... ist es schließlich ein",
            "Geschenk von Zant! Wäre doch",
            "unhöflich, wenn wir es nicht bei",
            "Gelegenheit verwenden würden!"
        ]
    },
    {
        "ID": "13, 213",
        "text": [
            "Weißt du, der {1a06ff000001}Schattenspiegel{1a06ff000000}",
            "ist womöglich der einzige Weg",
            "zu Zant..."
        ]
    },
    {
        "ID": "13, 235",
        "text": [
            "Aber als Zant die Macht im",
            "{1a06ff000001}Schattenreich{1a06ff000000} an sich riss,",
            "wurden wir alle in {1a06ff000001}Wesen",
            "der Finsternis{1a06ff000000} verwandelt!"
        ]
    },
    {
        "ID": "13, 241",
        "text": [
            "Nun... Zant ist mit Sicherheit",
            "irgendwo im {1a06ff000001}Schattenreich{1a06ff000000}."
        ]
    },
    {
        "ID": "14, 13",
        "text": [
            "Wir müssen Zant besiegen. Dann",
            "wird auch der Fluch gelöst, der auf",
            "mir liegt... und wir können Zelda",
            "ihre Kraft zurückgeben!"
        ]
    },
    {
        "ID": "14, 31",
        "text": [
            "...und die {1a06ff000001}dunkle Magie{1a06ff000000} dieses",
            "Fluchs muss dann auf {1a06ff000001}Zant{1a06ff000000} über-",
            "gegangen sein."
        ]
    },
    {
        "ID": "14, 32",
        "text": [
            "Jetzt wissen wir zwar, woher",
            "Zants magische Kraft kommt,",
            "aber es ist schon viel zu spät,",
            "um noch etwas zu tun!"
        ]
    },
    {
        "ID": "14, 47",
        "text": [
            "Zant!"
        ]
    },
    {
        "ID": "8, 151",
        "text": [
            "Er ist die einzige Möglichkeit, zu",
            "Zant zu gelangen. Suchen wir ihn",
            "gemeinsam!"
        ]
    },
    {
        "ID": "17, 184",
        "text": [
            "{1a0903000000000be5}Du freundest dich mit der",
            "{1a05000001}{1a06ff000001}Ooccoo {1a06ff000000}an!{1a05000002} {1a07000007000a}Sie kann dich in",
            "den Laden von Kumula warpen.",
            "",
            "Lege sie auf {1a05030002} und",
            "verwende sie mithilfe von {1a05030002}.",
            "Legst du sie auf {1a05030008}, musst du",
            "sie nicht erst auf {1a05030002} legen."
        ]
    },
    {
        "ID": "18, 0",
        "text": [
            "{1a0903000000000c2d}Eine geliehene Bombentasche von Iza.",
            "Lege die Bomben auf {1a05030002} und verwende sie",
            "mithilfe von {1a05030001} oder {1a05030002}.",
            "Kombiniere sie auf dem Item-Bildschirm",
            "mithilfe von {1a05030014} mit dem {1a06ff000001}Heroen-Bogen{1a06ff000000},",
            "um {1a06ff000001}Bombenpfeile{1a06ff000000} herzustellen."
        ]
    },
    {
        "ID": "18, 31",
        "text": [
            "Ooccoos einziger Sohn, ihr Liebling.",
            "Sprich ihn mit {1a05030002} an, um zurück ins",
            "Dungeon und zur Ooccoo gebracht zu",
            "werden. Legst du ihn auf {1a05030008}, musst du",
            "nicht erst auf {1a05030002} umschalten, um ihn",
            "zu verwenden."
        ]
    },
    {
        "ID": "18, 32",
        "text": [
            "Von Rusl vorbereitetes Geschenk.",
            "Der Griff ist aus Ordoner Horn.",
            "Schwinge es mit {1a05030011}, mit {1a05030001} steckst",
            "du es zurück in die Scheide."
        ]
    },
    {
        "ID": "18, 120",
        "text": [
            "Ein Brief von Renado an Telma. Er",
            "beschreibt, wie Ilia ihr Gedächtnis zurück-",
            "gewinnen kann. Willst du ihn jemandem",
            "zeigen, lege ihn auf {1a05030008} oder {1a05030002}."
        ]
    },
    {
        "ID": "18, 122",
        "text": [
            "Gehörte früher zu Ilias Besitztümern.",
            "Sie wird helfen, Ilias Gedächtnis zurück-",
            "zubringen.",
            "Willst du sie jemandem zeigen, lege sie",
            "auf {1a05030008} oder {1a05030002}."
        ]
    },
    {
        "ID": "18, 123",
        "text": [
            "Die Alte, die Ilia gerettet hat, trug diese",
