[
    {
        "ID": "19, 237",
        "text": [
            "Wow!",
            "Der ist ja von Renado!"
        ]
    },
    {
        "ID": "19, 240",
        "text": [
            "Also gut... Ilia braucht",
            "unsere Hilfe!"
        ]
    },
    {
        "ID": "19, 254",
        "text": [
            "{1a06ff000002}Auru{1a06ff000000} heißt er, ein netter Alter.",
            "Du solltest ihn kennenlernen!",
            "Ihr würdet euch bestimmt gut",
            "verstehen!"
        ]
    },
    {
        "ID": "20, 0",
        "text": [
            "{1a06ff000002}Ashei{1a06ff000000} heißt sie, ein ganz süßes",
            "Mädchen. Du solltest sie kennen-",
            "lernen! Ihr würdet euch bestimmt",
            "gut verstehen!"
        ]
    },
    {
        "ID": "20, 6",
        "text": [
            "{1a06ff000002}Shad{1a06ff000000} heißt er, ist etwa so alt",
            "wie du... Ich meine, ihr solltet",
            "euch wirklich kennenlernen!"
        ]
    },
    {
        "ID": "20, 7",
        "text": [
            "Ach ja... Wenn du nach Kakariko",
            "gehst, richte Renado auf jeden",
            "Fall Grüße von mir aus!"
        ]
    },
    {
        "ID": "20, 10",
        "text": [
            "Wie geht's eigentlich",
            "der kleinen Ilia?"
        ]
    },
    {
        "ID": "20, 11",
        "text": [
            "Ich bin sicher, Renado wird eine",
            "Methode finden, ihre Erinnerung",
            "zurückzubringen!"
        ]
    },
    {
        "ID": "20, 13",
        "text": [
            "Wegen Ilia solltest du dich einfach",
            "auf Renado verlassen... und",
            "dich ganz auf deine eigenen",
            "Aufgaben konzentrieren!"
        ]
    },
    {
        "ID": "20, 16",
        "text": [
            "Wenn du nicht weißt, wo du",
            "anfangen sollst, solltest du",
            "dich einmal mit {1a06ff000002}Auru{1a06ff000000} treffen!",
            "Er ist einer von uns..."
        ]
    },
    {
        "ID": "20, 18",
        "text": [
            "Wenn du nicht weißt, wo du",
            "anfangen sollst, solltest du",
            "dich einmal mit {1a06ff000002}Ashei{1a06ff000000} treffen!",
            "Sie ist eine von uns..."
        ]
    },
    {
        "ID": "20, 20",
        "text": [
            "Wenn du nicht weißt, wo du",
            "anfangen sollst, solltest du",
            "dich einmal mit {1a06ff000002}Rusl{1a06ff000000} treffen!"
        ]
    },
    {
        "ID": "20, 23",
        "text": [
            "Ich glaube, {1a06ff000002}Shad{1a06ff000000} ist auch gerade",
            "dort. Er ist einer von uns... und",
            "wollte in Kakariko ein paar Nach-",
            "forschungen anstellen."
        ]
    },
    {
        "ID": "20, 36",
        "text": [
            "Was...?",
            "Ilias Gedächtnis...?!?"
        ]
    },
    {
        "ID": "20, 39",
        "text": [
            "Und dass du mir gut",
            "auf Ilia aufpasst, verstanden?!?"
        ]
    },
    {
        "ID": "20, 85",
        "text": [
            "{1a07ff00010055}Übrigens... Diese Kleine... Ilia...",
            "Sie hat nicht zufällig über mich",
            "gesprochen?"
        ]
    },
    {
        "ID": "20, 111",
        "text": [
            "Gib sie doch einfach dieser",
            "Kleinen, dieser Ilia, zurück!"
        ]
    },
    {
        "ID": "20, 114",
        "text": [
            "Eine Schnitzerei von dieser Ilia",
            "oder so... die habe ich nicht",
            "gesehen!"
        ]
    },
    {
        "ID": "20, 183",
        "text": [
            "Suchst du etwa dieses Ding,",
            "das {1a06ff000001}Ilia{1a06ff000000} bei sich hatte?"
        ]
    },
    {
        "ID": "20, 189",
        "text": [
            "Und zurückbekommen musst du",
            "sie! Sie ist ein Schlüssel zu",
            "Ilias {1a06ff000001}Erinnerung{1a06ff000000}!"
        ]
    },
    {
        "ID": "20, 192",
        "text": [
            "Hol dir die {1a06ff000001}Schnitzerei{1a06ff000000} und",
            "bring sie zu Ilia!"
        ]
    },
    {
        "ID": "21, 31",
        "text": [
            "{1a06ff000008}Bomben{1a06ff000000}",
            "Ein Bestseller aus Barnes' Bomben-",
            "fabrik: Wird immer wieder gerne",
            "gekauft!"
        ]
    },
    {
        "ID": "21, 135",
        "text": [
            "Wenn ja, dann solltest du es",
            "{1a06ff000001}Shad{1a06ff000000} erzählen... Er würde sich",
            "bestimmt freuen!"
        ]
    },
    {
        "ID": "22, 76",
        "text": [
            "Mich nennen die Leute {1a06ff000002}Shad{1a06ff000000}.",
            "Schön, dich zu sehen."
        ]
    },
    {
        "ID": "22, 176",
        "text": [
            "...Ich bin {1a06ff000002}Ashei{1a06ff000000}."
        ]
    },
    {
        "ID": "23, 149",
        "text": [
            "Was?!?",
            "Königin Rutela?"
        ]
    },
    {
        "ID": "23, 181",
        "text": [
            "Auru versucht gerade in der",
            "Nähe des {1a06ff000001}Hylia-Sees{1a06ff000000}, etwas über",
            "die Gerudo-Wüste zu erfahren."
        ]
    },
    {
        "ID": "23, 182",
        "text": [
            "Ashei ist gerade unterwegs...",
            "Sie meinte, sie will sich einmal",
            "in den {1a06ff000001}Schneebergen{1a06ff000000} umsehen."
        ]
    },
    {
        "ID": "23, 183",
        "text": [
            "Rusl wollte sich in den {1a06ff000001}heiligen",
            "Hain{1a06ff000000} aufmachen. Ich glaube, er",
            "liegt ungefähr da, wo das Zeichen",
            "auf der Karte ist..."
        ]
    },
    {
        "ID": "23, 184",
        "text": [
            "Shad ist gerade in Kakariko.",
            "Wenn du auch hin willst, dann",
            "sieh doch gleich auch mal nach",
            "den Kindern, {1a05000000}!"
        ]
    },
    {
        "ID": "23, 217",
        "text": [
            "Verzeih, ich habe mich noch",
            "gar nicht vorgestellt...{1a07000007000a} Ich bin",
            "{1a06ff000002}Agitha{1a06ff000000}, die Prinzessin",
            "des Insektenreichs."
        ]
    },
    {
        "ID": "24, 106",
        "text": [
            "Jovani"
        ]
    },
    {
        "ID": "24, 108",
        "text": [
            "Mich nennt man {1a06ff000002}Jovani{1a06ff000000}{1a070000070005}.{1a070000070005}.{1a070000070005}. Aber",
            "seit ich Geld brauchte und meine",
            "Seele einem Dämon verkauft habe,",
            "sehe ich so aus wie jetzt!"
        ]
    },
    {
        "ID": "24, 109",
        "text": [
            "Meiner Freundin kann ich so nicht",
            "unter die Augen treten... und mein",
            "Kater {1a06ff000002}Gengle{1a06ff000000} sitzt auf meinem Kopf",
            "und ist genauso starr wie ich!"
        ]
    },
    {
        "ID": "24, 138",
        "text": [
            "Nicht nur ich, auch Gengle kann",
            "sich wieder frei bewegen!{1a07000007000a}",
            "Das verdanken wir doch",
            "bestimmt dir, oder?!?"
        ]
    },
    {
        "ID": "24, 141",
        "text": [
            "So, Gengle kann sich jetzt auch",
            "wieder bewegen... Das verdanken",
            "wir doch sicher dir, oder?"
        ]
    },
    {
        "ID": "24, 164",
        "text": [
            "Mich nennen sie Gengle...",
            "Bin so was wie der Boss der",
            "Katzen hier im Ort!"
        ]
    },
    {
        "ID": "27, 91",
        "text": [
            "Wo ist nur Jovani?"
        ]
    },
    {
        "ID": "27, 92",
        "text": [
            "Was macht Gengle nur die",
            "ganze Zeit in dem Haus...?"
        ]
    },
    {
        "ID": "27, 99",
        "text": [
            "Normalerweise treffen wir uns",
            "ja immer direkt vor Jovanis",
            "Haus..."
        ]
    },
    {
        "ID": "27, 108",
        "text": [
            "Was? Jovani?",
            "Der ist eben hinausgeflogen.",
            "Mit unglaublicher Energie!"
        ]
    },
    {
        "ID": "27, 109",
        "text": [
            "Was auch immer... Hauptsache,",
            "dass es Gengle auch gut geht."
        ]
    },
    {
        "ID": "27, 114",
        "text": [
            "Gengle ist heute schon wieder",
            "nicht aus dem Haus gekommen{1a070000070005}.{1a070000070005}.{1a070000070005}."
        ]
    },
    {
        "ID": "27, 117",
        "text": [
            "Gengle geht es also gut!",
            "Wie wunderbar!"
        ]
    },
    {
        "ID": "31, 69",
        "text": [
            "{1a06ff000006}Prinzessin Agitha"
        ]
    },
    {
        "ID": "31, 70",
        "text": [
            "Casa {1a06ff000002}Jovani"
        ]
    },
    {
        "ID": "39, 71",
        "text": [
            "Sag mal, mein Freund... Warst du",
            "schon mal bei {1a06ff000001}Agitha{1a06ff000000} in der",
            "kleinen Gasse hier?"
        ]
    },
    {
        "ID": "39, 180",
        "text": [
            "Jovani... {1a070000070005}Jovani...",
            "{1a07000007000a}Dummer, großer... {1a070000070005}Jovani...",
            "{1a07000007000a}Zuviel Gier... {1a070000070005}Zuwenig Hirn...{1a070000070005}",
            "Jetzt hat ein Dämon... {1a070000070005}seine Seele!"
        ]
    },
    {
        "ID": "39, 183",
        "text": [
            "Hast du ein wenig Zeit?",
            "{1a07000007000a}Und kennst du einen Mann",
            "namens Jovani?"
        ]
    },
    {
        "ID": "39, 232",
        "text": [
            "Hast du etwa bei Agitha etwas",
            "zu erledigen?"
        ]
    },
    {
        "ID": "39, 236",
        "text": [
            "Du... {1a070000070005}Was für eine{1a07000007000a} Beziehung{1a07000007000a} hast",
            "du eigentlich zu Agitha...?!?"
        ]
    }
]