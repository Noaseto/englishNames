[
    {
        "ID": "19, 157",
        "text": [
            "Wenn mit Ilia alles klar ist,",
            "könnte sie wenigstens kurz",
            "schreiben, damit wir uns",
            "keine Sorgen machen müssen."
        ]
    },
    {
        "ID": "19, 185",
        "text": [
            "Erzähl aber keinem davon... Vor",
            "allem Renado darf unter keinen",
            "Umständen etwas davon erfahren,",
            "klar?!?"
        ]
    },
    {
        "ID": "20, 89",
        "text": [
            "Ich wollte auch Malo mal zeigen,",
            "wie gut ich geworden bin!"
        ]
    },
    {
        "ID": "20, 146",
        "text": [
            "Und... Ilia... ist doch sicher",
            "auch dort, oder?"
        ]
    },
    {
        "ID": "20, 161",
        "text": [
            "Selbst Renado darfst du nichts",
            "verraten. Kannst du das schwören?{1a05000020}"
        ]
    },
    {
        "ID": "21, 84",
        "text": [
            "Rusl wollte die Kinder retten, aber",
            "er wurde von einem der Monster",
            "angegriffen... und dann sind die",
            "Biester in den Wald verschwunden!"
        ]
    },
    {
        "ID": "21, 131",
        "text": [
            "Na, egal...{1a07000007000a} Übrigens, wenn ich mich",
            "nicht irre, ist das da drüben doch",
            "die Katze von der alten Sera aus",
            "dem Laden, oder?"
        ]
    },
    {
        "ID": "21, 133",
        "text": [
            "Übrigens...{1a07000007000a} Ist das da drüben",
            "nicht die Katze von Sera aus dem",
            "Laden?"
        ]
    },
    {
        "ID": "21, 168",
        "text": [
            "Rusl ist ja verletzt... Also werde",
            "ich mich auf die Suche nach den",
            "Kindern machen."
        ]
    },
    {
        "ID": "21, 169",
        "text": [
            "Aber Rusl haben sie erwischt,",
            "obwohl er ein Schwert hatte! Ohne",
            "Waffe hast du doch keine Chance!"
        ]
    },
    {
        "ID": "21, 170",
        "text": [
            "Keine Sorge...! Das Schwert,",
            "das wir der königlichen Familie als",
            "Geschenk überbringen wollten, ist",
            "noch in Rusls Haus!"
        ]
    },
    {
        "ID": "21, 171",
        "text": [
            "Na gut... Wenn du es sagst, Bo.",
            "Also gut, ich hol dann jetzt den..."
        ]
    },
    {
        "ID": "21, 175",
        "text": [
            "Ich gehe zu Rusl und hole unser",
            "Geschenk, das Schwert..."
        ]
    },
    {
        "ID": "21, 176",
        "text": [
            "Schließlich sollte ich so schnell",
            "wie möglich an Rusls Stelle nach",
            "den Kindern suchen..."
        ]
    },
    {
        "ID": "21, 177",
        "text": [
            "Also gut, Bo... Ich bin gleich",
            "wieder da... Also..."
        ]
    },
    {
        "ID": "21, 188",
        "text": [
            "Irgendwelche Monster haben sie",
            "entführt! Ilia, die Kinder, alle..."
        ]
    },
    {
        "ID": "21, 189",
        "text": [
            "Rusl ist verletzt.",
            "Deshalb hat sich der Bürgermeister",
            "auf die Suche gemacht... aber er ist",
            "ja auch nicht mehr der Jüngste..."
        ]
    },
    {
        "ID": "21, 196",
        "text": [
            "Kümmer du dich nur um Ilia und",
            "die Kinder!"
        ]
    },
    {
        "ID": "21, 228",
        "text": [
            "Eigentlich arbeitet er gerade an",
            "einem Schild für Colins Vater Rusl."
        ]
    },
    {
        "ID": "21, 232",
        "text": [
            "Gehen dir unsere beiden Kleinen,",
            "Talo und Malo, auch nicht allzu",
            "sehr auf die Nerven?"
        ]
    },
    {
        "ID": "21, 238",
        "text": [
            "Er arbeitet gerade an einem Schild",
            "für Colins Vater Rusl."
        ]
    },
    {
        "ID": "21, 242",
        "text": [
            "Tut mir wirklich Leid, dass Talo und",
            "Malo gestern so ungezogen waren!"
        ]
    },
    {
        "ID": "21, 247",
        "text": [
            "Aber ich muss mich bei dir ent-",
            "schuldigen... Talo und Malo waren",
            "wohl gestern sehr ungezogen!"
        ]
    },
    {
        "ID": "22, 30",
        "text": [
            "Mein Talo...! Mein Malo...!",
            "Wo seid ihr jetzt nur...?"
        ]
    },
    {
        "ID": "22, 73",
        "text": [
            "Sag mal, Beth! Weißt du eigentlich,",
            "was so eine Schleuder kostet?!?",
            "Kannst du nicht deine Mama fragen,",
            "ob sie sie uns einmal ausleiht?"
        ]
    },
    {
        "ID": "22, 76",
        "text": [
            "Bitte, Beth! Nur ansehen!{1a07000007000a}",
            "Die Schleuder... {1a070000070005}aus dem Laden...!"
        ]
    },
    {
        "ID": "22, 83",
        "text": [
            "Den hätte ich auch Malo",
            "gerne mal gezeigt..."
        ]
    },
    {
        "ID": "22, 88",
        "text": [
            "Du willst doch sowieso nur zu Ilia,",
            "oder? Aber hier kommst du nicht",
            "so leicht vorbei!"
        ]
    },
    {
        "ID": "22, 133",
        "text": [
            "{1a07ff00010050}Wetten, Beth hat heimlich schon mal",
            "mit der Schleuder geschossen?!?"
        ]
    },
    {
        "ID": "22, 152",
        "text": [
            "{1a07ff00010050}Beth, du hast diese Schleuder doch",
            "garantiert schon einmal ausprobiert...!"
        ]
    },
    {
        "ID": "22, 155",
        "text": [
            "{1a0903000000000705}Auf {1a05000010} oder {1a0500000f} legen... Schießen mit",
            "{1a06ff000001}Kürbiskernen{1a06ff000000}... Mithilfe von {1a0500000d} das",
            "Ziel anvisieren... {1a07ff00010050}Beth hat das ganz",
            "sicher schon mal gemacht!"
        ]
    },
    {
        "ID": "22, 231",
        "text": [
            "Meine Tochter Beth hat sich",
            "aufgeregt, weil es alles nur",
            "Sachen für Jungs sind..."
        ]
    },
    {
        "ID": "22, 234",
        "text": [
            "Und Beth wird ihrer Mutter immer",
            "ähnlicher! Ob ich wohl irgendwann",
            "zwei Drachen im Haus habe?"
        ]
    },
    {
        "ID": "23, 99",
        "text": [
            "Schnüff... Beth...",
            "Meine arme Beth..."
        ]
    },
    {
        "ID": "23, 110",
        "text": [
            "Und unsere kleine Beth?",
            "Geht es ihr gut?"
        ]
    },
    {
        "ID": "23, 223",
        "text": [
            "Talo ist immer noch nicht zurück..."
        ]
    },
    {
        "ID": "23, 225",
        "text": [
            "Wo könnte Talo nur sein?"
        ]
    },
    {
        "ID": "23, 228",
        "text": [
            "Du, {1a07000007000f}{1a05000000}...",
            "{1a07000007001e}Gehst du zu Ilia?"
        ]
    },
    {
        "ID": "23, 233",
        "text": [
            "Komm, lass uns zu Ilia gehen!"
        ]
    },
    {
        "ID": "24, 61",
        "text": [
            "Vielleicht hast du es ja auch schon",
            "gehört...? Die Kinder... Ilia... Sie",
            "wurden alle entführt!"
        ]
    },
    {
        "ID": "24, 157",
        "text": [
            "Talo und Malo sind weg.",
            "Sie wollten diesen Affen jagen..."
        ]
    },
    {
        "ID": "24, 160",
        "text": [
            "Und, {1a05000000}?",
            "Hast du Talo gefunden?"
        ]
    },
    {
        "ID": "25, 4",
        "text": [
            "Ilia, du weißt gar nicht, was",
            "gestern passiert ist, oder?"
        ]
    },
    {
        "ID": "25, 102",
        "text": [
            "Du gehst wohl auf die Weide,",
            "um Fado zu helfen. Sehr schön!"
        ]
    },
    {
        "ID": "25, 107",
        "text": [
            "Sag mal, {1a05000000}...",
            "Du wirst Fado doch helfen, oder?"
        ]
    },
    {
        "ID": "25, 153",
        "text": [
            "Heute ist Fado allein auf der",
            "Weide. Kümmert sich um alles..."
        ]
    },
    {
        "ID": "25, 160",
        "text": [
            "Ich wusste doch, man kann Fado",
            "nicht allein lassen..."
        ]
    },
    {
        "ID": "25, 166",
        "text": [
            "Und Fado, dieser Tollpatsch...",
            "Den Preis der Ziege werde ich ihm",
            "von seinem Lohn abziehen!"
        ]
    },
    {
        "ID": "25, 173",
        "text": [
            "Ja?",
            "{1a07000007000a}Wolltest du vielleicht zu Ilia?"
        ]
    },
    {
        "ID": "25, 176",
        "text": [
            "Tut mir Leid, aber Ilia meinte, ich",
            "soll dich auf keinen Fall reinlassen,",
            "falls du heute vorbeikommst."
        ]
    },
    {
        "ID": "25, 183",
        "text": [
            "Grrr! Fado!",
            "Heute also schon wieder...!"
        ]
    },
    {
        "ID": "25, 186",
        "text": [
            "Kannst du nicht zu Ilia gehen und",
            "sie bitten, dass sie dir das Pferd",
            "doch wieder zurückgibt?"
        ]
    },
    {
        "ID": "25, 206",
        "text": [
            "Viel wichtiger ist doch, dass Ilia",
            "und die Kinder schnell ins Dorf",
            "zurückkommen können. Alle zählen",
            "auf dich, {1a05000000}!"
        ]
    },
    {
        "ID": "25, 218",
        "text": [
            "Wo Ilia ist, weiß auch keiner...",
            "Vielleicht ist sie ja zusammen mit",
            "den Kindern..."
        ]
    },
    {
        "ID": "25, 221",
        "text": [
            "Rusl hat sich beim Kampf gegen",
            "die Monster verletzt... Er wollte",
            "verhindern, dass sie die Kinder",
            "entführen!"
        ]
    },
    {
        "ID": "35, 46",
        "text": [
            "Fados Haus"
        ]
    },
    {
        "ID": "35, 47",
        "text": [
            "Hier wohnen",
            "Gront und Bakka.",
            "{1a07ff0001004b}Und Talo. Und Malo."
        ]
    },
    {
        "ID": "35, 48",
        "text": [
            "Bürgermeister Bos Haus."
        ]
    },
    {
        "ID": "35, 49",
        "text": [
            "Hier wohnen",
            "Rusl, Ulina & Colin."
        ]
    },
    {
        "ID": "61, 171",
        "text": [
            "Mithilfe von {1a05030004} den Item-Bildschirm",
            "öffnen und auf {1a05030002} legen...",
            "Schießen mit {1a06ff000001}Kürbiskernen{1a06ff000000}... {1a07ff00010050}Beth",
            "hat das garantiert schon mal gemacht!"
        ]
    }
]