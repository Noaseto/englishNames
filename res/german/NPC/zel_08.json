            ""
        ]
    },
    {
        "ID": "21, 242",
        "index": "0x16d",
        "attributes": "15f200002c000000ff00001d01000400",
        "text": [
            "Ich bin {1a06ff000002}Iza{1a06ff000000}.",
            "Ich verleihe hier Boote."
        ]
    },
    {
        "ID": "23, 16",
        "index": "0x28b",
        "attributes": "1710000006000000ff00000009000400",
        "text": [
            "Du kennst sicherlich Telma.",
            "Ich bin oft bei ihr im Laden,",
            "man nennt mich {1a06ff000002}Auru{1a06ff000000}."
        ]
    },
    {
        "ID": "23, 32",
        "index": "0x29b",
        "attributes": "1720000006000000ff00000002000400",
        "text": [
            "Bitte übergib dies {1a06ff000001}Fyer{1a06ff000000}. Er betreibt",
            "einen Freizeitpark am {1a06ff000001}Hylia-See{1a06ff000000},",
            "nicht weit von hier."
        ]
    },
    {
        "ID": "23, 39",
        "index": "0x2a2",
        "attributes": "1727000006000000ff00000009000400",
        "text": [
            "Es gibt da diesen Menschen, {1a06ff000001}Fyer{1a06ff000000}",
            "heißt er... Ich habe ihm einmal sehr",
            "geholfen, er steht tief in meiner",
            "Schuld."
        ]
    },
    {
        "ID": "23, 49",
        "index": "0x2ac",
        "attributes": "1731000006000000ff00000009000400",
        "text": [
            "Zeig {1a06ff000001}Fyer {1a06ff000000}vom Freizeitpark am",
            "{1a06ff000001}Hylia-See{1a06ff000000} die Notiz, die ich dir",
            "gegeben habe."
        ]
    },
    {
        "ID": "23, 51",
        "index": "0x2ae",
        "attributes": "1733000006000000ff00000009000400",
        "text": [
            "Gib dies {1a06ff000001}Fyer{1a06ff000000}. Er ist der Betreiber",
            "des Freizeitparks am {1a06ff000001}Hylia-See{1a06ff000000}."
        ]
    },
    {
        "ID": "24, 57",
        "index": "0x328",
        "attributes": "183900006b0e0000ff00010007000400",
        "text": [
            "Oh, hallo!{1a07000007000a}",
            "Ich bin {1a06ff000001}Plumm{1a06ff000000}."
        ]
    },
    {
        "ID": "24, 73",
        "index": "0x338",
        "attributes": "184900006b0e0000ff00000007000400",
        "text": [
            "Oh, ein Mensch! {1a070000070005}",
            "Ich bin {1a06ff000001}Plumm{1a06ff000000}."
        ]
    },
    {
        "ID": "24, 75",
        "index": "0x33a",
        "attributes": "184b00006b0e0000ff00000007000400",
        "text": [
            "Plumm kann die Menschensprache",
            "nicht so gut..."
        ]
    },
    {
        "ID": "24, 166",
        "index": "0x36e",
        "attributes": "18a600000a000000ff00000004000400",
        "text": [
            "Oh, ich habe mich gar nicht",
            "vorgestellt...{1a07000007000a} Ich bin die Prinzessin",
            "des Insektenkönigreichs. {1a06ff000002}Agitha{1a06ff000000},",
            "so nennt man mich."
        ]
    },
