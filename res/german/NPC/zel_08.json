        ]
    },
    {
        "ID": "20, 181",
        "index": "0xf3",
        "attributes": "14b500002b000000ff00010003020400",
        "text": [
            "Hallo! Hereinspaziert! Willkommen",
            "in Falbi' {1a06ff000002}Hühnerflugstation{1a06ff000000}!"
        ]
    },
    {
        "ID": "20, 202",
        "index": "0x108",
        "attributes": "14ca000003020100ff00000000000800",
        "text": [
            "{1a090300000000050d}Die Sensation am Hylia-See,",
            "der schwimmende {1a06ff000005}Freizeitpark{1a06ff000000}",
            "von Fyer und Falbi! ",
            "Kanonenritt und {1a06ff000002}Hühnerflug-",
