[
    {
        "ID": "1, 81",
        "index": "0x150",
        "attributes": "0151000002090200ec01000000000400",
        "text": [
            "Du freundest dich mit der",
            "{1a05000001}{1a06ff000001}Tante {1a06ff000000}an!{1a05000002} {1a07000007000a}Sie kann dich in",
            "den Laden von City in the sky warpen.",
            "",
            "Lege sie auf {1a05000010} oder {1a0500000f} und",
            "verwende sie, um schnell und",
            "sicher in die Stadt in den",
            "Wolken zu reisen."
        ]
    },
    {
        "ID": "1, 83",
        "index": "0x152",
        "attributes": "0153000002090200ee01000000000400",
        "text": [
