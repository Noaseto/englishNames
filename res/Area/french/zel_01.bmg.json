[
    {
        "ID": "19, 158",
        "index": "0x15",
        "attributes": "139e00001a000003ff00000000000400",
        "text": [
            "Peut-être qu'elle se plaît tellement",
            "à Kakariko qu'elle m'a oublié?"
        ]
    },
    {
        "ID": "19, 221",
        "index": "0x54",
        "attributes": "13dd00001a000003ff00000000000400",
        "text": [
            "Ah bon... {1a07000007000a}J'aimerais pouvoir aider",
            "les habitants de Kakariko, tu sais."
        ]
    },
    {
        "ID": "20, 144",
        "index": "0x107",
        "attributes": "149000001a000001ff0000000e030400",
        "text": [
            "Je vois... Comme ça, les enfants",
            "sont au village de Kakariko!{1a07000004003c}"
        ]
    },
    {
        "ID": "20, 162",
        "index": "0x119",
        "attributes": "14a200001a000000ff00000000000400",
        "text": [
            "Retourne vite à la Montagne de la ",
            "Mort et aide les gens de Kakariko."
        ]
    },
    {
        "ID": "20, 251",
        "index": "0x172",
        "attributes": "14fb00001b000000ff00000000020400",
        "text": [
            "Tu sais, j'suis jamais sorti de",
            "Ordon, moi..."
