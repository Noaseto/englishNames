        ]
    },
    {
        "ID": "24, 164",
        "index": "0x4c3",
        "attributes": "18a4000025000000ff00000001000400",
        "text": [
            "{1a05000000}, {1a070000070005}dis...{1a07000007000f} Tu pars ",
