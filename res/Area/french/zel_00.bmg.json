[
    {
        "ID": "0, 141",
        "index": "0x8c",
        "attributes": "008d0000020902002801000000000400",
        "text": [
            "{1a05000001}Vous obtenez l'{1a06ff000001}épée de Ordon{1a06ff000000}!{1a05000002}",
            "{1a07000007000a}Cette lame a été forgée par Moï,",
            "guerrier de Ordon, comme cadeau",
            "pour la famille royale d'Hyrule."
        ]
    },
    {
        "ID": "0, 143",
        "index": "0x8e",
        "attributes": "008f0000020902002a01000000000400",
        "text": [
            "{1a09030000000007f3}{1a05000001}Vous obtenez le {1a06ff000001}bouclier de",
            "Ordon{1a06ff000000}!{1a05000002} {1a07000007000a}Appuyez sur {1a0500000d} pour",
            "vous protéger avec. Attention,",
            "il craint le feu!"
        ]
    },
    {
        "ID": "0, 149",
        "index": "0x94",
        "attributes": "00950000020902003001000000000400",
        "text": [
            "{1a05000001}Vous obtenez l'{1a06ff000001}armure magique{1a06ff000000}!{1a05000002}",
            "{1a07000007000a}La sublime, la magnifique,",
            "la superbe armure magique!",
            "Merci les Malo Mart!",
            "Son enchantement consomme",
            "des {1a06ff000006}rubis{1a06ff000000} quand vous la portez,",
            "et encore plus quand vous",
            "subissez une attaque.",
            "Tant que vous avez des {1a06ff000006}rubis{1a06ff000000},",
            "vous ne subissez aucun dégât!",
            "Sinon, l'effet disparaît et elle",
            "ne fait que vous encombrer..."
        ]
    },
    {
        "ID": "1, 81",
        "index": "0x150",
        "attributes": "0151000002090200ec01000000000400",
        "text": [
            "{1a0903000000000be5}{1a05000001}Vous avez un nouveau",
            "compagnon! Le {1a06ff000001}fils de Baba{1a06ff000000}!{1a05000002}",
            "{1a07000007000a}Vous pouvez compter sur cet",
            "ami de City in the Sky!",
            "Assignez-le à {1a05000010} ou {1a0500000f} pour",
            "faire appel à ses services et",
            "il vous mènera directement",
            "auprès de Baba."
        ]
    },
    {
        "ID": "1, 83",
        "index": "0x152",
        "attributes": "0153000002090200ee01000000000400",
        "text": [
            "{1a05000001}Vous obtenez une {1a06ff000001}petite clé{1a06ff000000}!{1a05000002}",
            "{1a07000007000a}Elle ouvre le portail qui mène",
            "à la forêt de Faron."
        ]
    },
    {
        "ID": "1, 88",
        "index": "0x157",
        "attributes": "0158000002090201f301000000000400",
        "text": [
            "{1a05000001}Vous obtenez la {1a06ff000001}clé du portail{1a06ff000000}!{1a05000002}",
            "{1a07000007000a}C'est la clé du portail qui",
            "ferme la route menant au",
            "village de Kakariko."
        ]
    },
    {
        "ID": "1, 89",
        "index": "0x158",
        "attributes": "0159000002090200f401000000000400",
        "text": [
            "{1a05000001}Vous obtenez un {1a06ff000001}potiron",
            "toalien{1a06ff000000}!{1a05000002}",
            "{1a07000007000a}Il provient de Ordon, votre",
            "village natal."
        ]
    },
    {
        "ID": "1, 90",
        "index": "0x159",
        "attributes": "015a000002090200f501000000000400",
        "text": [
            "{1a05000001}Vous obtenez du {1a06ff000001}fromage",
            "toalien{1a06ff000000}!{1a05000002}",
            "{1a07000007000a}Il a été fait avec le lait des",
            "chèvres de Ordon."
        ]
    },
    {
        "ID": "1, 99",
        "index": "0x162",
        "attributes": "0163000002090200fe01000000000400",
        "text": [
            "{1a05000001}Vous recevez une{1a06ff000001} petite clé{1a06ff000000}!{1a05000002} ",
