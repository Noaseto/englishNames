[
    {
        "ID": "23, 126",
        "index": "0xd6",
        "attributes": "177e0000150d0000ff00000000000400",
        "text": [
            "{1a07000007001e}{1a05000001}{1a06ff000001}Zant{1a05000002}"
        ]
    },
    {
        "ID": "23, 129",
        "index": "0xd9",
        "attributes": "17810000150d0000ff00000000000400",
        "text": [
            "Mais je refuse de reconnaître {1a06ff000001}Zant",
            "{1a06ff000000}comme {1a06ff000001}notre roi{1a06ff000000}! Son pouvoir ne",
            "lui donne pas ce droit!"
        ]
    },
    {
        "ID": "23, 140",
        "index": "0xe4",
        "attributes": "178c00003a000000ff00000000000400",
        "text": [
            "Pourr autant, si Gorr Coron t'a",
            "laissé passer, c'est que tu es",
            "vrraiment forrt."
        ]
    },
    {
        "ID": "23, 141",
        "index": "0xe5",
        "attributes": "178d00003a000000ff00000000000400",
        "text": [
            "Je suis l'un des quatrre doyens ",
            "de la trribu des Gorrons, et je ",
            "m'appelle {1a06ff000002}Gorr Amoto{1a06ff000000}."
        ]
    },
    {
        "ID": "23, 143",
        "index": "0xe7",
        "attributes": "178f00003a000000ff00000001010400",
        "text": [
            "Voici l'un des morrceaux de la {1a06ff000001}clé",
            "{1a06ff000000}qui ouvrre la porrte de la pièce où",
            "est enferrmé notrre {1a06ff000001}chef{1a06ff000000}, {1a06ff000001}Darbus{1a06ff000000}."
        ]
    },
    {
        "ID": "23, 149",
        "index": "0xed",
        "attributes": "179500003c000000ff00000000000400",
        "text": [
            "Je suis l'un des quatre doyens de",
            "la tribu des Gorons, {1a06ff000002}Gor Ebizo{1a06ff000000}."
        ]
    },
    {
        "ID": "23, 168",
        "index": "0x100",
        "attributes": "17a800003b000000ff00000000000400",
        "text": [
            "On dit qu'elle purrifiait le Mal.",
            "Peut-êtrre te serra-t-elle utile",
            "pourr calmer Darbus..."
        ]
    },
    {
        "ID": "27, 92",
        "index": "0x1c8",
        "attributes": "1b5c0000150d0000ff00000000000400",
        "text": [
            "... En échange, je te promets de",
            "faire quelque chose contre {1a06ff000001}Zant{1a06ff000000}..."
        ]
    },
    {
        "ID": "27, 126",
        "index": "0x1ea",
        "attributes": "1b7e0000150d0000ff00000000000400",
        "text": [
            "Hé, tu te souviens de ce qu'a dit",
            "Barnes, l'artisan en bombes?",
            "{1a07000007000a}Sa lettre! Lis sa lettre!"
        ]
    },
    {
        "ID": "27, 163",
        "index": "0x20f",
        "attributes": "1ba30000150d0000ff00000000000400",
        "text": [
            "Tu ne te souviens pas? Barnes,",
            "l'artisan en démolition de Cocorico,",
            "il t'a bien envoyé une lettre, non?"
        ]
    },
    {
        "ID": "29, 79",
        "index": "0x24a",
        "attributes": "1d4f000042080500ff00000000000400",
        "text": [
            "Je suis la Great Fairy, reine",
            "de toutes les fées de ce monde."
        ]
    },
    {
        "ID": "31, 190",
        "index": "0x29b",
        "attributes": "1fbe0000150d0000ff000d001f1f0400",
        "text": [
            "Zut! Zant de malheur!",
            "{1a07000007000f}Mais on ne se laissera pas faire",
            "aussi facilement!"
        ]
    },
    {
        "ID": "37, 133",
        "index": "0x467",
        "attributes": "25850000150d0000ff000d001f1f0400",
        "text": [
            "Je dois avouer que Zant a eu ",
            "une bonne idée en cachant ",
            "un morceau du miroir ici."
        ]
    },
    {
        "ID": "37, 235",
        "index": "0x4cd",
        "attributes": "25eb000035000000ff00000000000400",
        "text": [
            "Notre contrée est désormais sous ",
            "le contrôle de Zant..."
        ]
    },
    {
        "ID": "37, 236",
        "index": "0x4ce",
        "attributes": "25ec000035000000ff00050000000400",
        "text": [
            "Le Palais appartient à la famille ",
            "royale! Zant est un traître, nous",
            "ne lui laisserons pas le Palais!"
        ]
    },
    {
        "ID": "37, 240",
        "index": "0x4d2",
        "attributes": "25f0000034000000ff00050000000400",
        "text": [
            "Nous ne reconnaissons pas Zant",
            "comme notre Roi légitime."
        ]
    },
    {
        "ID": "38, 73",
        "index": "0x4e6",
        "attributes": "26490000150d0000ff000d001f1f0400",
        "text": [
            "Zant est probablement au plus",
            "profond du Palais."
        ]
    },
    {
        "ID": "38, 77",
        "index": "0x4ea",
        "attributes": "264d0000150d0000ff000d001f1f0400",
        "text": [
            "Ici aussi, tout a bien changé depuis",
            "que Zant a pris le pouvoir..."
        ]
    },
    {
        "ID": "38, 81",
        "index": "0x4ee",
        "attributes": "26510000150d0000ff000d001f1f0400",
        "text": [
            "Si nous terrassons Zant,",
            "peut-être pouvons-nous encore",
            "les faire redevenir comme avant."
        ]
    },
    {
        "ID": "38, 96",
        "index": "0x4fd",
        "attributes": "26600000150d0000ff000d001f1f0400",
        "text": [
            "Allez! Ramenons les Astres à leurs",
            "places originelles et allons rendre",
            "une petite visite à Zant!"
        ]
    },
    {
        "ID": "38, 98",
        "index": "0x4ff",
        "attributes": "26620000150d0000ff000d001f1f0400",
        "text": [
            "Si nous le trouvons, nous devrions",
            "découvrir où se cache Zant!"
        ]
    },
    {
        "ID": "38, 99",
        "index": "0x500",
        "attributes": "26630000150d0000ff000d001f1f0400",
        "text": [
            "Si nous replaçons cet Astre sur",
            "son socle d'origine, nous devrions ",
            "découvrir où se cache Zant."
        ]
    },
    {
        "ID": "38, 103",
        "index": "0x504",
        "attributes": "26670000150d0000ff000d001f1f0400",
        "text": [
            "Avec cette épée, tu devrais pouvoir",
            "dissiper les ombres que Zant a",
            "répandues un peu partout..."
        ]
    },
    {
        "ID": "38, 104",
        "index": "0x505",
        "attributes": "26680000150d0000ff000d001f1f0400",
        "text": [
            "Utilise cette lame pour pourfendre ",
            "les ténèbres et te frayer un chemin ",
            "jusqu'à Zant!"
        ]
    },
    {
        "ID": "38, 107",
        "index": "0x508",
        "attributes": "266b0000150d0000ff000d001f1f0400",
        "text": [
            "Zant... comment a-t-il pu oser?"
        ]
    },
    {
        "ID": "38, 114",
        "index": "0x50f",
        "attributes": "26720000150d0000ff000d001f1f0400",
        "text": [
            "Ce brouillard noir que tu vois est",
            "fait de cristaux d'ombre créés par",
            "Zant. Ils étouffent la lumière."
        ]
    },
    {
        "ID": "38, 117",
        "index": "0x512",
        "attributes": "26750000150d0000ff000d001f1f0400",
        "text": [
            "Si tu perds ton temps avec eux, ",
            "tu n'atteindras jamais Zant!"
        ]
    },
    {
        "ID": "38, 118",
        "index": "0x513",
        "attributes": "26760000150d0000ff000d001f1f0400",
        "text": [
            "Ne t'occupe pas du menu fretin! ",
            "Attaque seulement l'image de",
            "Zant!"
        ]
    },
    {
        "ID": "38, 125",
        "index": "0x51a",
        "attributes": "267d0000150d0000ff000d001f1f0400",
        "text": [
            "Ganondorf a utilisé Zant pour se",
            "réincarner dans le monde de la",
            "lumière...",
            "",
            "Maintenant, on sait d'où vient",
            "la barrière qui enferme le Château",
            "d'Hyrule!"
        ]
    },
    {
        "ID": "38, 138",
        "index": "0x527",
        "attributes": "268a0000150d0000ff0000001f1f0400",
        "text": [
            "La lumière qui réside dans ton",
            "épée peut dissiper la magie de",
            "Zant!"
        ]
    },
    {
        "ID": "42, 254",
        "index": "0x5b4",
        "attributes": "2afe0000150d0000ff000d0000000400",
        "text": [
            "Tout ce que Zant a pu faire, c'est",
            "{1a06ff000001}briser{1a06ff000000} le {1a06ff000001}Miroir{1a06ff000000} en quelques",
            "morceaux..."
        ]
    }
]