[
    {
        "ID": "19, 157",
        "text": [
            "Però Ilia potrebbe darmi notizie...",
            "Anche solo per dire che sta bene..."
        ]
    },
    {
        "ID": "19, 185",
        "text": [
            "Ma devi mantenere il segreto e non",
            "dirlo a nessuno! E soprattutto...",
            "{1a070000070014}acqua in bocca con Renado!"
        ]
    },
    {
        "ID": "20, 89",
        "text": [
            "Volevo fare vedere a Malo",
            "come sono bravo!"
        ]
    },
    {
        "ID": "20, 145",
        "text": [
            "Meno male. {1a070000070014}Renado è un amico",
            "di vecchia data. Se sono nelle sue",
            "mani, possiamo stare tranquilli."
        ]
    },
    {
        "ID": "20, 146",
        "text": [
            "A proposito! Anche la mia piccola",
            "Ilia è con loro, vero?!"
        ]
    },
    {
        "ID": "20, 152",
        "text": [
            "Allora... {1a07000007000a}Renado ti ha detto che..."
        ]
    },
    {
        "ID": "20, 161",
        "text": [
            "Soprattutto, non devi farne parola ",
            "con Renado. Me lo prometti?{1a05000020}"
        ]
    },
    {
        "ID": "21, 84",
        "text": [
            "Rusl era andato ad aiutarli, ma è",
            "stato attaccato dai mostri... E",
            "li ha visti sparire nella foresta..."
        ]
    },
    {
        "ID": "21, 131",
        "text": [
            "Che giovane esuberante...{1a07000007000a}",
            "Piuttosto, quello là non",
            "è il gatto di Sera, la",
            "proprietaria della bottega?"
        ]
    },
    {
        "ID": "21, 133",
        "text": [
            "Ehi, ma... {1a07000007000a}Quello là non è il gatto di",
            "Sera, la proprietaria del bazar?"
        ]
    },
    {
        "ID": "21, 168",
        "text": [
            "Rusl è ferito seriamente, andrò io",
            "a cercare i bambini al posto suo!"
        ]
    },
    {
        "ID": "21, 170",
        "text": [
            "Non ti preoccupare, a casa di Rusl",
            "c'è ancora la Spada che doveva",
            "essere presentata in dono a Hyrule."
        ]
    },
    {
        "ID": "21, 175",
        "text": [
            "Io vado a casa di Rusl a prendere",
            "la Spada che deve essere",
            "presentata in dono a Hyrule."
        ]
    },
    {
        "ID": "21, 176",
        "text": [
            "Presto! Devo andare a cercare",
            "i bambini al posto di Rusl.",
            "Lui è ferito seriamente..."
        ]
    },
    {
        "ID": "21, 188",
        "text": [
            "All'improvviso sono arrivati i mostri",
            "e li hanno portati tutti via... Ilia,",
            "i bambini..."
        ]
    },
    {
        "ID": "21, 189",
        "text": [
            "Per giunta Rusl è stato ferito... ",
            "E ora il capo villaggio è andato",
            "a cercarli, ma ha anche la sua età...",
            "E ti dirò che sono preoccupato."
        ]
    },
    {
        "ID": "21, 196",
        "text": [
            "Tu vai a salvare i bambini e Ilia!"
        ]
    },
    {
        "ID": "21, 228",
        "text": [
            "In questo momento sta facendo uno",
            "Scudo per Rusl, il papà di Colin."
        ]
    },
    {
        "ID": "21, 232",
        "text": [
            "Quelle pesti dei miei bambini,",
            "Talo e Malo, ti danno fastidio?"
        ]
    },
    {
        "ID": "21, 238",
        "text": [
            "In questo momento sta facendo uno",
            "Scudo per Rusl, il papà di Colin."
        ]
    },
    {
        "ID": "21, 242",
        "text": [
            "Scusa tanto se ieri Talo e Malo",
            "ti hanno infastidito..."
        ]
    },
    {
        "ID": "21, 247",
        "text": [
            "Piuttosto... Scusa tanto se ieri",
            "Talo e Malo ti hanno infastidito..."
        ]
    },
    {
        "ID": "22, 30",
        "text": [
            "Talo... Malo...",
            "Tornate a casa sani e salvi!"
        ]
    },
    {
        "ID": "22, 73",
        "text": [
            "Ho la faccia di uno che ha tutte",
            "quelle Rupie da spendere? Però,",
            "Beth... potresti prestarmela",
            "un attimino!"
        ]
    },
    {
        "ID": "22, 76",
        "text": [
            "Senti, Bethna bella, fammela",
            "solo vedere, dai! Voglio vedere",
            "la Fionda della bottega!"
        ]
    },
    {
        "ID": "22, 83",
        "text": [
            "Avrei voluto farla vedere",
            "anche a te, Malo!"
        ]
    },
    {
        "ID": "22, 88",
        "text": [
            "Vuoi andare a trovare Ilia, vero?",
            "E io non ti farò passare!"
        ]
    },
    {
        "ID": "22, 152",
        "text": [
            "{1a07ff00010050}Beth, ammettilo! Tu hai",
            "già tirato con la Fionda!"
        ]
    },
    {
        "ID": "22, 155",
        "text": [
            "{1a0903000000000705}Assegnala a {1a05000010} o a {1a0500000f}. Usa i {1a06ff000001}Semi",
            "di zucca{1a06ff000000} al posto dei pallini...",
            "Poi mira con {1a0500000d}...",
            "{1a07ff0001004b}Per me Beth è un'esperta con la Fionda!"
        ]
    },
    {
        "ID": "22, 231",
        "text": [
            "Tutti i nuovi prodotti sono articoli",
            "per maschietti... Mia figlia Beth se",
            "la prenderà a morte con me!"
        ]
    },
    {
        "ID": "23, 99",
        "text": [
            "Oh, piccola Beth...",
            "Perdonami..."
        ]
    },
    {
        "ID": "23, 110",
        "text": [
            "Come sta la mia piccola Beth?"
        ]
    },
    {
        "ID": "23, 223",
        "text": [
            "Talo non torna..."
        ]
    },
    {
        "ID": "23, 225",
        "text": [
            "Che cosa sarà successo a Talo?"
        ]
    },
    {
        "ID": "23, 228",
        "text": [
            "... {1a07000007000f}{1a05000000},",
            "{1a07000007001e}vuoi andare da Ilia?"
        ]
    },
    {
        "ID": "23, 233",
        "text": [
            "Andiamo insieme a cercare Ilia!"
        ]
    },
    {
        "ID": "24, 61",
        "text": [
            "Forse l'hai già sentito, ma i bambini",
            "e Ilia sono stati rapiti..."
        ]
    },
    {
        "ID": "24, 157",
        "text": [
            "Talo e Malo si sono messi",
            "a rincorrere la scimmietta."
        ]
    },
    {
        "ID": "24, 160",
        "text": [
            "{1a05000000},",
            "hai visto Talo?"
        ]
    },
    {
        "ID": "25, 4",
        "text": [
            "Ilia, non sai cos'è successo ieri..."
        ]
    },
    {
        "ID": "25, 102",
        "text": [
            "Vai ad aiutare Fado? Buon lavoro!"
        ]
    },
    {
        "ID": "25, 107",
        "text": [
            "E allora, {1a05000000}?",
            "Vai ad aiutare Fado, oppure no?"
        ]
    },
    {
        "ID": "25, 153",
        "text": [
            "Sembra che oggi Fado sia da solo",
            "alla fattoria."
        ]
    },
    {
        "ID": "25, 160",
        "text": [
            "Perciò non mi sento tranquillo",
            "a lasciare la fattoria nelle mani",
            "di Fado!"
        ]
    },
    {
        "ID": "25, 166",
        "text": [
            "Tratterrò dallo stipendio",
            "di Fado il costo della capra!"
        ]
    },
    {
        "ID": "25, 173",
        "text": [
            "Eh? {1a07000007000a}Forse cerchi Ilia?"
        ]
    },
    {
        "ID": "25, 176",
        "text": [
            "Scusa, {1a07000007000a}ma Ilia mi ha chiesto",
            "di non farti entrare, oggi."
        ]
    },
    {
        "ID": "25, 183",
        "text": [
            "Ahahah! Quel Fado...",
            "L'ha combinata anche oggi!"
        ]
    },
    {
        "ID": "25, 186",
        "text": [
            "Vai da Ilia e cerca di farti",
            "restituire il cavallo!"
        ]
    },
    {
        "ID": "25, 206",
        "text": [
            "Piuttosto, {1a05000000},",
            "cerca di far tornare al più presto ",
            "al villaggio Ilia e i bambini!"
        ]
    },
    {
        "ID": "25, 218",
        "text": [
            "È sparita anche Ilia...",
            "Forse l'hanno presa loro..."
        ]
    },
    {
        "ID": "25, 221",
        "text": [
            "Rusl si è scontrato con i mostri che",
            "hanno rapito i bambini e si è ferito."
        ]
    },
    {
        "ID": "35, 46",
        "text": [
            "Casa di Fado"
        ]
    },
    {
        "ID": "35, 47",
        "text": [
            "Casetta di Jagar e Kelly",
            "{1a07ff0001004b}(e di Talo e Malo)"
        ]
    },
    {
        "ID": "35, 48",
        "text": [
            "Casa del capo villaggio Bo"
        ]
    },
    {
        "ID": "35, 49",
        "text": [
            "Casa di Rusl, Ully e Colin"
        ]
    },
    {
        "ID": "61, 171",
        "text": [
            "Assegnala a {1a05030002} dallo schermo {1a05030004}...",
            "Usa i {1a06ff000001}Semi di zucca{1a06ff000000} come pallini...",
            "{1a07ff0001004b}Secondo me Beth mente e sa come si fa..."
        ]
    }
]