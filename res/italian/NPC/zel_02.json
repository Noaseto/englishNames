[
    {
        "ID": "19, 147",
        "text": [
            "Hai ascoltato bene cosa aveva",
            "da dirti il Pastore Renado?"
        ]
    },
    {
        "ID": "19, 148",
        "text": [
            "Pare sia preoccupato per Ilia,",
            "ma è preoccupato anche per",
            "la questione degli Zora del",
            "lago Hylia..."
        ]
    },
    {
        "ID": "20, 104",
        "text": [
            "Sai, pare che quel bambino, Ralis,",
            "sia il diretto discendente della",
            "famiglia reale degli Zora."
        ]
    },
    {
        "ID": "20, 107",
        "text": [
            "Chissà cosa starà facendo Ralis",
            "nel suo villaggio..."
        ]
    },
    {
        "ID": "20, 108",
        "text": [
            "Sarebbe bello se ritornasse",
            "la memoria anche ad Ilia..."
        ]
    },
    {
        "ID": "20, 109",
        "text": [
            "Come sono felice che sia Ralis",
