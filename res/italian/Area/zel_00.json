[
    {
        "ID": "0, 141",
        "text": [
            "{1a05000001}Hai ottenuto la {1a06ff000001}Spada di Ordon{1a06ff000000}!{1a05000002}",
            "{1a07000007000a}Spada forgiata da Moy,",
            "spadaccino del villaggio Ordon.",
            "Dono per i reali di Hyrule."
        ]
    },
    {
        "ID": "0, 143",
        "text": [
            "{1a09030000000007f3}{1a05000001}Hai ottenuto lo {1a06ff000001}Scudo di Ordon{1a06ff000000}!{1a05000002}",
            "{1a07000007000a}Per difenderti, usa {1a0500000d}.",
            "A contatto con il fuoco, brucia! "
        ]
    },
    {
        "ID": "0, 149",
        "text": [
            "{1a05000001}Hai ottenuto l'{1a06ff000001}Armatura magica{1a06ff000000}!{1a05000002}",
            "{1a07000007000a}Ce l'hai fatta! L'hai comprata!",
            "Si trovava nel Malo Mart!",
            "",
            "Quando la indossi, le {1a06ff000006}Rupie{1a06ff000000} si",
            "tramutano in potere magico e",
            "riesci a respingere ogni attacco.",
            "",
            "Quando subisci degli attacchi,",
            "consumi molte Rupie. Se rimani",
            "senza {1a06ff000006}Rupie{1a06ff000000}, sarà difficile",
            "muoverti con l'Armatura."
        ]
    },
    {
        "ID": "1, 81",
        "text": [
            "{1a0903000000000be5}{1a05000001}Hai incontrato {1a06ff000001}Polly Molly{1a06ff000000}!{1a05000002}",
            "{1a07000007000a}Una persona fidata",
            "proveniente dalla City in the Sky.",
            "",
            "Assegnala a {1a05000010} o {1a0500000f} e chiamala",
            "per farti teletrasportare alla",
            "bottega della City in the Sky."
        ]
    },
    {
        "ID": "1, 83",
        "text": [
            "{1a05000001}Hai ottenuto una {1a06ff000001}Piccola chiave{1a06ff000000}!{1a05000002}",
            "{1a07000007000a}La Chiave che apre il cancello",
            "della foresta di Faron."
        ]
    },
    {
        "ID": "1, 88",
        "text": [
            "{1a05000001}Ora hai la {1a06ff000001}Chiave del cancello{1a06ff000000}!{1a05000002}",
            "{1a07000007000a}È la Chiave per aprire",
            "il cancello che conduce",
            "al villaggio Kakariko."
        ]
    },
    {
        "ID": "1, 89",
        "text": [
            "{1a05000001}Ora hai una {1a06ff000001}Zucca di Ordon{1a06ff000000}!{1a05000002}",
            "{1a07000007000a}Le vere zucche nostrane...",
            "Che voglia di assaggiarle!"
        ]
    },
    {
        "ID": "1, 90",
        "text": [
            "{1a05000001}Ora hai il {1a06ff000001}Formaggio di Ordon{1a06ff000000}!{1a05000002}",
            "{1a07000007000a}Il formaggio fatto con il",
            "latte delle capre di Ordon."
        ]
    },
    {
        "ID": "1, 99",
        "text": [
            "{1a05000001}Hai ottenuto una {1a06ff000001}Piccola chiave{1a06ff000000}!{1a05000002}",
            "{1a07000007000a}La Chiave che apre il cancello",
            "della foresta di Faron."
        ]
    },
    {
        "ID": "1, 141",
        "text": [
            "Spada di Ordon"
        ]
    },
    {
        "ID": "1, 143",
        "text": [
            "Scudo di Ordon"
        ]
    },
    {
        "ID": "2, 143",
        "text": [
            "{1a0903000000000c4f}Scudo realizzato secondo la tradizione",
            "ordonina. Con la spada sguainata,",
            "difenditi con {1a0500000d}. A contatto",
            "con il fuoco brucia!"
        ]
    },
    {
        "ID": "2, 178",
        "text": [
            "Scettro misterioso che infonde vita alle",
            "statue. Il suo potere è svanito quando",
            "è stato prelevato dal Temple of Time.",
            "Così com'è non può essere usato..."
        ]
    },
    {
        "ID": "3, 21",
        "text": [
            "Il profumo del borsellino di Iria",
            "trovato nella piana delle terre di Lanayru."
        ]
    },
    {
        "ID": "3, 23",
        "text": [
            "L'odore degli spettri che vagano",
            "nel Arbiter's Grounds."
        ]
    },
    {
        "ID": "3, 25",
        "text": [
            "L'odore dei bambini del villaggio Ordon",
            "che impregna la Spada di legno trovata",
            "nella piana delle terre di Eldin."
        ]
    },
    {
        "ID": "3, 37",
        "text": [
            "Scarabeo {1a05060002} dorato trovato",
            "nella pianura delle terre di Faron."
        ]
    },
    {
        "ID": "3, 38",
        "text": [
            "Scarabeo {1a05060003} dorato trovato",
            "nella pianura delle terre di Faron."
        ]
    },
    {
        "ID": "3, 41",
        "text": [
            "Lucanide {1a05060002} dorato trovato",
            "nella pianura a nord del Hyrule",
            "Castle."
        ]
    },
    {
        "ID": "3, 42",
        "text": [
            "Lucanide {1a05060003} dorato trovato",
            "nella pianura a nord del Hyrule",
            "castle."
        ]
    },
    {
        "ID": "3, 43",
        "text": [
            "Cavalletta {1a05060002} dorata trovata",
            "nella pianura a nord del villaggio",
            "Kakariko."
        ]
    },
    {
        "ID": "3, 44",
        "text": [
            "Cavalletta {1a05060003} dorata trovata",
            "nella pianura a nord del villaggio",
            "Kakariko."
        ]
    },
    {
        "ID": "3, 45",
        "text": [
            "Neanide {1a05060002} dorato trovato",
            "presso il ponte di Eldin."
        ]
    },
    {
        "ID": "3, 46",
        "text": [
            "Neanide {1a05060003} dorato trovato",
            "presso il ponte di Eldin."
        ]
    },
    {
        "ID": "3, 47",
        "text": [
            "Onisco {1a05060002} dorato trovato",
            "presso la gola di Kakariko."
        ]
    },
    {
        "ID": "3, 48",
        "text": [
            "Onisco {1a05060003} dorato trovato",
            "presso la gola di Kakariko."
        ]
    },
    {
        "ID": "3, 56",
        "text": [
            "Libellula {1a05060003} dorata trovata",
            "a la Upper Zora's River."
        ]
    },
    {
        "ID": "3, 57",
        "text": [
            "Formica {1a05060002} dorata trovata",
            "nel cimitero del villaggio Kakariko."
        ]
    },
    {
        "ID": "3, 58",
        "text": [
            "Formica {1a05060003} dorata trovata",
